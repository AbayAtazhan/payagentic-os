# ==============================================================================
# PayAgentic OS — Environment Configuration
# ==============================================================================
# Copy this file to .env.local:
#   cp env.example .env.local
# NOTE: All keys are OPTIONAL. If omitted, PayAgentic OS runs automatically
# in zero-fail high-fidelity simulation mode with 50+ pre-populated transactions!
# ==============================================================================

# 1. PayPal Developer Sandbox Credentials (developer.paypal.com)
# Obtain from Dashboard -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# 2. PayPal Webhook ID (Optional - for live webhook signature verification)
PAYPAL_WEBHOOK_ID=

# 3. AI Copilot / LLM Configuration (Optional)
# If set, PayAgentic Copilot uses OpenAI tool-calling (gpt-4o-mini).
# If unset, PayAgentic Copilot uses deterministic local tool routing.
OPENAI_API_KEY=
AG_STUDIO_OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini,gpt-4o

# 4. AG Studio License Key (Optional - for AG Studio enterprise features)
AG_STUDIO=

# 5. Environment & Demo Controls
# Set to 'true' to force simulated merchant mode even if PayPal keys are set
NEXT_PUBLIC_FORCE_DEMO=false
NODE_ENV=development
