# ProofPay configuration. Copy to .env.local:  cp env.example .env.local
# Without PayPal keys the app runs with simulated payments. Without an AI key, AI review is disabled.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox PERSONAL account email that receives freelancer payouts in the demo
# (developer.paypal.com -> Testing Tools -> Sandbox Accounts)
DEMO_FREELANCER_EMAIL=

# AI: any OpenAI-compatible chat API. Defaults to DeepSeek.
DEEPSEEK_API_KEY=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash

# Signs the locked milestone terms. Any long random string.
PROOFPAY_SECRET=

# Payment policy (optional)
# AUTO_RELEASE_CAP=500
# MIN_CONFIDENCE=80
# PLATFORM_FEE_PERCENT=5

# Optional: raises the GitHub API limit when reviewing repositories
# GITHUB_TOKEN=
